<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vibehome.launcher" android:versionCode="24" android:versionName="0.14.3">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Development access is optional and never granted by the launcher. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <queries>
        <package android:name="com.htc.htcsettings" />
        <package android:name="com.android.tv.settings" />
        <package android:name="com.htc.htclauncherhighenglishd08" />
        <package android:name="com.softwinner.awlivetv" />
        <package android:name="com.softwinner.vis" />
        <package android:name="com.softwinner.TvdFileManager" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
    </queries>
    <application android:label="Vibe Home" android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner" android:theme="@style/AppTheme"
        android:allowBackup="false" android:hardwareAccelerated="true" android:supportsRtl="true">
        <activity android:name=".ProjectionActivity" android:exported="false" android:screenOrientation="landscape" />
        <provider android:name=".ProjectionDraftProvider" android:authorities="com.vibehome.launcher.projection"
            android:exported="true" android:grantUriPermissions="false" />
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".HomeEntry" android:targetActivity=".MainActivity"
            android:label="Vibe Home" android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
